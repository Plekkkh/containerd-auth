# ОТКЛЮЧЕННЫЙ ФОЛБЭК (расширение .disabled — не применяется kubectl автоматически).
# Если в твоей версии Kyverno нет CEL-расширения time.Now() в ValidatingPolicy,
# используй этот JMESPath-вариант вместо 20-policy-fullmoon-cel.yaml.
# Даты сверяются строково (YYYY-MM-DD из time_now_utc()[:10]) — без парсинга ISO в CEL.
#
# apiVersion: kyverno.io/v1
# kind: ClusterPolicy
# metadata:
#   name: fullmoon-edit-window-jmespath
# spec:
#   validationFailureAction: Enforce
#   background: false
#   rules:
#   - name: edits-only-on-fullmoon
#     match:
#       any:
#       - resources:
#           kinds: ["Deployment", "StatefulSet", "DaemonSet"]
#           operations: ["UPDATE"]
#     preconditions:
#       all:
#       - key: "{{ time_now_utc() }}"
#         operator: NotIn
#         value: "2026-10-26*, 2026-11-24*, 2026-12-24*, 2027-01-22*, 2027-02-21*, 2027-03-22*, 2027-04-21*, 2027-05-20*, 2027-06-19*, 2027-07-18*, 2027-08-17*, 2027-09-15*, 2027-10-15*, 2027-11-14*, 2027-12-13*"
#     validate:
#       message: "Редактирование workload'ов разрешено только в сутки полнолуния."
#       deny: {}
#
# ВНИМАНИЕ: JMESPath-переменные Kyverno не поддерживают glob-паттерны в operator NotIn напрямую;
# этот вариант — иллюстративный, требуется проверка на живом кластере. Если Glob не сработает,
# положись на основной CEL-вариант (20-policy-fullmoon-cel.yaml).
